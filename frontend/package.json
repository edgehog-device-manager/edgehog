    "@types/react-relay": "^18.2.1",
    "@types/relay-runtime": "^20.1.1",
    "@types/semver": "^7.8.0",
    "@vitejs/plugin-react": "^5.2.0",
    "apexcharts": "^5.15.2",
    "babel-plugin-relay": "^21.0.1",
    "bootstrap": "^5.3.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.22",
    "graphql": "^17.0.2",
